<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vyra.dental</groupId>
    <artifactId>vyra-dental-software</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.3</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <junit.version>5.11.3</junit.version>
        <mainClass>com.vyra.dental.App</mainClass>
        <!-- Datos de ejemplo del diseño: mvn javafx:run -Dvyra.demo=true -->
        <vyra.demo>false</vyra.demo>
        <!-- Empaquetado (mvn -Pinstalador package): app-image no necesita nada más;
             msi y exe necesitan WiX Toolset 3 en el PATH -->
        <jpackage.tipo>app-image</jpackage.tipo>
        <jpackage.version>1.0.0</jpackage.version>
    </properties>

    <dependencies>

        <!-- Driver JDBC para conectarse a la base de datos SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Jakarta Bean Validation (anotaciones @NotBlank, @Size, ...) + implementacion -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
        </dependency>
        <!-- Necesario para que Hibernate Validator interpole los mensajes -->
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>5.0.0</version>
        </dependency>

        <!-- Exportación a PDF de la historia clínica, el odontograma y los reportes (RF-11) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.3</version>
        </dependency>

        <!-- Pruebas unitarias (JUnit 5) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Ejecuta las pruebas JUnit 5 con mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Las pruebas usan una base en memoria, nunca vyra.db -->
                        <vyra.bd.url>jdbc:sqlite::memory:</vyra.bd.url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                    <options>
                        <option>-Dvyra.demo=${vyra.demo}</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Versión instalable para Windows (docs/09-plan-implementacion.md, fase 8):
            mvn -Pinstalador package                      → target/instalador/Vyra/Vyra.exe (carpeta portable)
            mvn -Pinstalador package -Djpackage.tipo=msi  → instalador .msi (requiere WiX Toolset 3)
          Las librerías van en el classpath (jlink no acepta módulos automáticos) y el
          runtime lo arma jpackage con los módulos del JDK que se listan abajo.
        -->
        <profile>
            <id>instalador</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-librerias</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/paquete</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copiar-aplicacion</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              tofile="${project.build.directory}/paquete/vyra.jar"/>
                                        <delete dir="${project.build.directory}/instalador"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${jpackage.tipo}</argument>
                                        <argument>--name</argument>
                                        <argument>Vyra</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Vyra</argument>
                                        <argument>--description</argument>
                                        <argument>Gestión de un consultorio dental</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/paquete</argument>
                                        <argument>--main-jar</argument>
                                        <argument>vyra.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.vyra.dental.Lanzador</argument>
                                        <!-- jdk.localedata: meses y días en español; jdk.unsupported: JavaFX -->
                                        <argument>--add-modules</argument>
                                        <argument>java.base,java.desktop,java.logging,java.management,java.naming,java.prefs,java.scripting,java.sql,java.sql.rowset,java.xml,jdk.charsets,jdk.crypto.ec,jdk.localedata,jdk.unsupported,jdk.zipfs</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-native-commands --strip-debug --no-man-pages --no-header-files --compress=zip-6</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/instalador</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
