<?xml version="1.0" encoding="UTF-8"?>

<?import com.vyra.dental.ui.Aviso?>
<?import com.vyra.dental.ui.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Inicio: docs/08-guia-frontend.md §7.2, referencia docs/ui/Inicio.html. Las tarjetas las arma InicioController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.InicioController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label fx:id="saludo" styleClass="titulo-pagina"/>
            <Label text="Este es el resumen de tu consultorio para hoy." styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonNuevoPaciente" text="Nuevo paciente" styleClass="btn-secundario"
                onAction="#nuevoPaciente" minWidth="-Infinity">
            <graphic>
                <Icono nombre="pacientes" tamano="16"/>
            </graphic>
        </Button>
        <Button fx:id="botonNuevaCita" text="Nueva cita" styleClass="btn-primario"
                onAction="#nuevaCita" minWidth="-Infinity">
            <graphic>
                <Icono nombre="mas" tamano="16"/>
            </graphic>
        </Button>
    </HBox>

    <Aviso fx:id="avisoProximas"/>
    <HBox fx:id="kpis" spacing="16"/>
    <HBox fx:id="cuerpo" spacing="20" fillHeight="false"/>
</VBox>
