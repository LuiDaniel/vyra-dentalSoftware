<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Reportes: docs/08-guia-frontend.md §7.9. Los filtros y el resultado los arma el controlador. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.ReportesController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label text="Reportes" styleClass="titulo-pagina"/>
            <Label text="Citas, historial de tratamientos de un paciente e ingresos por periodo."
                   styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="tipos" styleClass="segmentado"/>
        <Button fx:id="botonExportar" text="Exportar PDF" styleClass="btn-secundario" disable="true"/>
    </HBox>

    <VBox fx:id="filtros" styleClass="card,reporte-filtros"/>
    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true"/>
    <VBox fx:id="resultado" spacing="16"/>
</VBox>
