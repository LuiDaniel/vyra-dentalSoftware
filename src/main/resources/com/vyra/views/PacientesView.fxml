<?xml version="1.0" encoding="UTF-8"?>

<?import com.vyra.dental.ui.Avatar?>
<?import com.vyra.dental.ui.Aviso?>
<?import com.vyra.dental.ui.CampoFormulario?>
<?import com.vyra.dental.ui.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pacientes: docs/08-guia-frontend.md §7.4, referencia docs/ui/Pacientes.html -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.PacientesController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label text="Pacientes" styleClass="titulo-pagina"/>
            <Label fx:id="resumen" styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonNuevo" text="Nuevo paciente" styleClass="btn-primario" onAction="#nuevo" minWidth="-Infinity">
            <graphic>
                <Icono nombre="mas" tamano="16"/>
            </graphic>
        </Button>
    </HBox>

    <HBox styleClass="lista-y-panel" fillHeight="false">
        <!-- Lista -->
        <VBox styleClass="card,lista" HBox.hgrow="ALWAYS" minWidth="480">
            <HBox styleClass="lista-barra">
                <HBox styleClass="buscador" HBox.hgrow="ALWAYS">
                    <Icono nombre="buscar" tamano="16"/>
                    <TextField fx:id="campoBuscar" promptText="Buscar por nombre o DNI" HBox.hgrow="ALWAYS"
                               accessibleText="Buscar pacientes"/>
                </HBox>
                <HBox fx:id="filtros" styleClass="filtros"/>
            </HBox>

            <TableView fx:id="tabla" styleClass="tabla-pacientes"/>

            <HBox styleClass="lista-pie">
                <Label fx:id="rango" styleClass="texto-secundario"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonAnterior" text="Anterior" styleClass="btn-secundario,btn-chico" onAction="#paginaAnterior"/>
                <Button fx:id="botonSiguiente" text="Siguiente" styleClass="btn-secundario,btn-chico" onAction="#paginaSiguiente"/>
            </HBox>
        </VBox>

        <!-- Ficha -->
        <VBox fx:id="panel" styleClass="panel-form,panel-ficha" prefWidth="440" minWidth="400" maxWidth="480">
            <HBox styleClass="ficha-encabezado">
                <Avatar fx:id="avatarFicha" styleClass="avatar-grande"/>
                <VBox styleClass="ficha-titulos" HBox.hgrow="ALWAYS">
                    <Label fx:id="tituloFicha" styleClass="panel-titulo" wrapText="true"/>
                    <Label fx:id="subtituloFicha" styleClass="texto-secundario" wrapText="true"/>
                </VBox>
            </HBox>

            <HBox styleClass="pestanas">
                <ToggleButton fx:id="pestanaDatos" text="Datos" styleClass="pestana" selected="true"/>
                <ToggleButton fx:id="pestanaHistoria" text="Historia clínica" styleClass="pestana"/>
                <ToggleButton fx:id="pestanaCitas" text="Citas" styleClass="pestana"/>
            </HBox>

            <!-- Pestaña Historia clínica: la arma HistoriaClinicaController (solo odontólogo y administrador) -->
            <VBox fx:id="contenidoHistoria" styleClass="ficha-formulario"/>

            <!-- Pestaña Citas: las citas del paciente, de la más reciente a la más antigua -->
            <VBox fx:id="contenidoCitas" styleClass="ficha-citas"/>

            <VBox fx:id="contenidoDatos" styleClass="ficha-formulario">
                <Label text="DATOS PERSONALES" styleClass="seccion-titulo"/>
                <GridPane styleClass="rejilla-formulario">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <CampoFormulario fx:id="cfNombres" etiqueta="Nombres" obligatorio="true" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <TextField fx:id="campoNombres" promptText="Ej. Carlos"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfApellidos" etiqueta="Apellidos" obligatorio="true" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="campoApellidos" promptText="Ej. Pérez Salas"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfDni" etiqueta="DNI" obligatorio="true" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <TextField fx:id="campoDni" promptText="8 dígitos"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfFechaNacimiento" etiqueta="Fecha de nacimiento" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <DatePicker fx:id="campoFechaNacimiento" promptText="dd/mm/aaaa" maxWidth="Infinity"/>
                    </CampoFormulario>
                </GridPane>

                <Label text="CONTACTO" styleClass="seccion-titulo"/>
                <GridPane styleClass="rejilla-formulario">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <CampoFormulario fx:id="cfTelefono" etiqueta="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <TextField fx:id="campoTelefono" promptText="9 dígitos"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfContactoEmergencia" etiqueta="Contacto de emergencia" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="campoContactoEmergencia" promptText="Nombre y teléfono"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfDireccion" etiqueta="Dirección" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <TextField fx:id="campoDireccion" promptText="Ej. Av. Principal 123"/>
                    </CampoFormulario>
                </GridPane>

                <Label text="INFORMACIÓN CLÍNICA" styleClass="seccion-titulo"/>
                <CampoFormulario fx:id="cfAlergias" etiqueta="Alergias">
                    <TextArea fx:id="campoAlergias" promptText="Vacío si no tiene alergias" prefRowCount="2" wrapText="true"/>
                </CampoFormulario>
                <Aviso fx:id="avisoAlergia"/>
                <CampoFormulario fx:id="cfAntecedentes" etiqueta="Antecedentes">
                    <TextArea fx:id="campoAntecedentes" promptText="Enfermedades, cirugías, medicación habitual…" prefRowCount="3" wrapText="true"/>
                </CampoFormulario>

                <Aviso fx:id="avisoFormulario"/>
            </VBox>

            <HBox fx:id="pie" styleClass="panel-pie">
                <Button fx:id="botonBaja" text="Dar de baja" styleClass="btn-peligro" onAction="#darDeBaja" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#cancelar" minWidth="-Infinity"/>
                <Button fx:id="botonGuardar" styleClass="btn-primario" onAction="#guardar" defaultButton="true"
                        minWidth="-Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
