<?xml version="1.0" encoding="UTF-8"?>

<?import com.vyra.dental.ui.Avatar?>
<?import com.vyra.dental.ui.Aviso?>
<?import com.vyra.dental.ui.CampoFormulario?>
<?import com.vyra.dental.ui.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Profesionales: docs/08-guia-frontend.md §7.10 (patrón lista + panel, como Pacientes) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.ProfesionalesController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label text="Profesionales" styleClass="titulo-pagina"/>
            <Label fx:id="resumen" styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo profesional" styleClass="btn-primario" onAction="#nuevo" minWidth="-Infinity">
            <graphic>
                <Icono nombre="mas" tamano="16"/>
            </graphic>
        </Button>
    </HBox>

    <HBox styleClass="lista-y-panel" fillHeight="false">
        <VBox styleClass="card,lista" HBox.hgrow="ALWAYS" minWidth="480">
            <TableView fx:id="tabla"/>
        </VBox>

        <VBox styleClass="panel-form,panel-ficha" prefWidth="440" minWidth="400" maxWidth="480">
            <HBox styleClass="ficha-encabezado">
                <Avatar fx:id="avatarFicha" styleClass="avatar-grande"/>
                <VBox styleClass="ficha-titulos" HBox.hgrow="ALWAYS">
                    <Label fx:id="tituloFicha" styleClass="panel-titulo" wrapText="true"/>
                    <Label fx:id="subtituloFicha" styleClass="texto-secundario" wrapText="true"/>
                </VBox>
            </HBox>

            <VBox styleClass="ficha-formulario">
                <GridPane styleClass="rejilla-formulario">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <CampoFormulario fx:id="cfNombres" etiqueta="Nombres" obligatorio="true" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <TextField fx:id="campoNombres" promptText="Ej. Marco"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfApellidos" etiqueta="Apellidos" obligatorio="true" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="campoApellidos" promptText="Ej. Salinas Vega"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfEspecialidad" etiqueta="Especialidad" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <TextField fx:id="campoEspecialidad" promptText="Ej. Endodoncia"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfTelefono" etiqueta="Teléfono" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="campoTelefono" promptText="9 dígitos"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfHorario" etiqueta="Horario de atención" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <TextField fx:id="campoHorario" promptText="Ej. Lun-Vie 08:00-14:00"/>
                    </CampoFormulario>
                    <CampoFormulario fx:id="cfUsuario" etiqueta="Usuario para iniciar sesión" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                        <ComboBox fx:id="campoUsuario" maxWidth="Infinity"/>
                    </CampoFormulario>
                </GridPane>
                <Label text="Solo aparecen los usuarios con rol Odontólogo que aún no tienen un profesional asociado. Con un usuario, el odontólogo ve sus propias citas."
                       styleClass="texto-apoyo" wrapText="true"/>
                <Aviso fx:id="avisoFormulario"/>
            </VBox>

            <HBox styleClass="panel-pie">
                <Button fx:id="botonEliminar" text="Eliminar" styleClass="btn-peligro" onAction="#eliminar" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-secundario" onAction="#cancelar" minWidth="-Infinity"/>
                <Button fx:id="botonGuardar" styleClass="btn-primario" onAction="#guardar" defaultButton="true"
                        minWidth="-Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
