<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pagos: docs/08-guia-frontend.md §7.8, referencia docs/ui/Pagos.html. Tarjetas y panel los arma el controlador. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.PagosController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label text="Pagos" styleClass="titulo-pagina"/>
            <Label text="Registra pagos asociados a tratamientos." styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="periodos" styleClass="segmentado"/>
    </HBox>

    <HBox fx:id="tarjetas" spacing="16"/>

    <HBox styleClass="lista-y-panel" fillHeight="false">
        <VBox styleClass="card,lista" HBox.hgrow="ALWAYS" minWidth="520">
            <HBox styleClass="lista-barra">
                <Label text="Pagos del periodo" styleClass="card-titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonExportar" text="Exportar" styleClass="btn-secundario,btn-chico" disable="true"/>
            </HBox>
            <TableView fx:id="tabla"/>
        </VBox>

        <VBox fx:id="panel" styleClass="panel-form,panel-ficha" prefWidth="440" minWidth="400" maxWidth="480"/>
    </HBox>
</VBox>
