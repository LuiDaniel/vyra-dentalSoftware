<?xml version="1.0" encoding="UTF-8"?>

<?import com.vyra.dental.ui.Avatar?>
<?import com.vyra.dental.ui.BuscadorPacientes?>
<?import com.vyra.dental.ui.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Historia clínica desde el menú: docs/08-guia-frontend.md §7.5. A la izquierda,
  el buscador de pacientes; a la derecha, la ficha del paciente elegido con su
  historia clínica (el mismo panel que la pestaña de la ficha de Pacientes).
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vyra.dental.controller.HistoriaClinicaController"
      styleClass="pagina">

    <HBox styleClass="pagina-encabezado">
        <VBox styleClass="pagina-titulos">
            <Label text="Historia clínica" styleClass="titulo-pagina"/>
            <Label fx:id="resumen" styleClass="texto-secundario"/>
        </VBox>
    </HBox>

    <HBox styleClass="lista-y-panel" fillHeight="false">
        <BuscadorPacientes fx:id="buscador" HBox.hgrow="ALWAYS" minWidth="420"/>

        <!-- Sin paciente elegido -->
        <VBox fx:id="sinPaciente" styleClass="card,estado-vacio" prefWidth="480" minWidth="420" maxWidth="520">
            <StackPane styleClass="estado-vacio-icono">
                <Icono nombre="historia" tamano="28"/>
            </StackPane>
            <Label text="Elige un paciente" styleClass="card-titulo"/>
            <Label text="Su historia clínica aparecerá aquí." styleClass="texto-secundario"/>
        </VBox>

        <!-- Ficha del paciente elegido -->
        <VBox fx:id="panel" styleClass="panel-form,panel-ficha" prefWidth="480" minWidth="420" maxWidth="520">
            <HBox styleClass="ficha-encabezado">
                <Avatar fx:id="avatarFicha" styleClass="avatar-grande"/>
                <VBox styleClass="ficha-titulos" HBox.hgrow="ALWAYS">
                    <Label fx:id="tituloFicha" styleClass="panel-titulo" wrapText="true"/>
                    <Label fx:id="subtituloFicha" styleClass="texto-secundario" wrapText="true"/>
                </VBox>
                <Button fx:id="botonOdontograma" styleClass="btn-icono" onAction="#abrirOdontograma"
                        accessibleText="Ver odontograma">
                    <graphic>
                        <Icono nombre="diente" tamano="18"/>
                    </graphic>
                </Button>
            </HBox>
            <fx:include fx:id="historia" source="HistoriaClinicaPanel.fxml"/>
        </VBox>
    </HBox>
</VBox>
